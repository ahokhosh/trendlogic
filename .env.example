# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_CLIENT_ID: Google OAuth 2.0 Client ID for YouTube Data API v3 integration.
YOUTUBE_CLIENT_ID=

# YOUTUBE_CLIENT_SECRET: Google OAuth 2.0 Client Secret for YouTube Data API v3 integration.
YOUTUBE_CLIENT_SECRET=

# TikTok Content Posting API (simultaneous TikTok publish of the same MP4).
# 1. Create an app at developers.tiktok.com, add "Login Kit" + "Content
#    Posting API", request scopes: user.info.basic, video.list, video.upload,
#    video.publish.
# 2. Register the Redirect URI shown in the app (Publisher -> Connect TikTok,
#    or GET /api/tiktok/oauth/url) — default is APP_URL + /tiktok/callback.
#    You can pin it here instead:
# TIKTOK_REDIRECT_URI=https://bidbes.com/trendlogic/tiktok/callback
# 3. While the TikTok app is unaudited: add your TikTok account as a test
#    user and publish as Private (SELF_ONLY) — public posts fail until audit.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Template voice recipe (Edge Neural, keyless — see temp/tts-llm-guide.md).
# Defaults: deep rough anchor (Christopher, rate -10%, pitch -20Hz).
# TEMPLATE_VOICE=en-US-ChristopherNeural
# TEMPLATE_RATE=-10%
# TEMPLATE_PITCH=-20Hz

# PIXVERSE_API_KEY: Real external AI motion video (PixVerse v6 text-to-video,
# 9:16). The "AI Video" path needs this key AND paid credits on the account.
PIXVERSE_API_KEY=
# PIXVERSE_MODEL=v6
# PIXVERSE_DURATION=5
# PIXVERSE_QUALITY=540p

# Downloader service origin for the Instagram motion clip
# (post-shot-0 slot). In-pod DNS by default; override for local dev.
# DOWNLOADER_BASE_URL=http://downloder:3000

# Internal text AI (ai-chatbot owns the free-model chain). Pod DNS by
# default; override for local dev (e.g. http://127.0.0.1:3006).
# AI_CHATBOT_URL=http://ai-chatbot:3000

# Instagram Discovery via RapidAPI
# (instagram-downloader-download-instagram-videos-stories1):
# GET /?Userinfo=<profileUrl> returns the latest 12 posts (video posts carry
# direct MP4s) + GET /get-info-rapidapi?url=<reelUrl> resolves any single reel
# with download_url + caption — no login, no scraping. Get a key at rapidapi.com
# and paste:
# Multi-key pool with automatic failover first -> last on 429/401/403:
# RAPIDAPI_KEY=key1,key2,key3
# RAPIDAPI_KEY=
# RAPIDAPI_IG_HOST=instagram-downloader-download-instagram-videos-stories1.p.rapidapi.com

# Redis for distributed queues/locks (optional; falls back to in-memory if unset).
# REDIS_URL=redis://127.0.0.1:6379
# DB pool size for high concurrency.
# DB_POOL_LIMIT=50
# IO_CONCURRENCY=8
# Disable background timers in secondary instances (run timers on one instance only).
# DISABLE_TIMERS=true

# Dedicated MySQL database for this service (same host/contract as the repo).
# Tables: tl_users, tl_sessions, tl_prefs, tl_videos.
DB_HOST=remote-pishgaman.runflare.com
DB_PORT=31720
DB_USER=root
DB_PASSWORD=
TRENDLOGIC_DB_NAME=dbvideo

# Registration invite code (mandatory): signup without this code 403s.
# Set the real value in .env / pod secrets — never commit it.
REGISTER_INVITE_CODE=1304

# Relax Shorts (latest Relax AI soundscape -> 40s Short -> YouTube).
# In-pod DNS by default; override for local dev (e.g. http://127.0.0.1:3210).
# RELAX_BASE_URL=http://relax:3000
# Public Relax base used for the backlink in the YouTube caption.
# RELAX_PUBLIC_URL=https://bidbes.com/relax

# Email (SMTP)
SMTP_HOST=smtp-de-01.runflare.com
SMTP_PORT=587
SMTP_USER=info@bidbes.com
SMTP_PASS=
SMTP_FROM=info@bidbes.com


