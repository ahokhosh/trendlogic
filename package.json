{
  "name": "trendlogic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server.cjs",
    "start": "node server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('server.cjs',{force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@napi-rs/canvas": "1.0.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "google-tts-api": "^2.0.2",
    "lucide-react": "^0.546.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^7.0.13",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.2.1",
    "ws": "^8.21.3",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
